  "network": {
    "protocol": "QSTP/2.1",
    "encryption": "AES-256-GCM + post-quantum-lattice",
    "handshake_timeout_ms": 250,
    "max_connections": 100000,
    "endpoints": [
      "quantum-node-01.internal",
      "quantum-node-02.internal",
      "arbitrage-relay.internal"
